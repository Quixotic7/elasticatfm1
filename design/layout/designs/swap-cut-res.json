              "when": {"warp": ["GSTR"]},
              "lanes": [
                [{"item": "grain_speed", "label": "STRCH"}, {"item": "grain_size", "label": "PWIN"}, {"item": "grain_density", "label": "SMTH"}, "warp_rate"]
              ]
            },
            {
              "when": {"warp": ["GSTR2"]},
              "lanes": [
                [{"item": "grain_speed", "label": "STRCH"}, {"item": "grain_size", "label": "PWIN"}, {"item": "grain_density", "label": "SMTH"}, "warp_rate"]
              ]
            },
            {
              "when": {"warp": ["CHOP"]},
              "lanes": [
                ["chop_slice_len", "chop_hold", "chop_loop_mode", "warp_rate"],
                ["chop_attack", "chop_release"]
              ]
            }
          ]
        },
        {
          "title": "RANGE",
          "picture": "wave-range",
          "lanes": [
            ["range_start", "range_end"]
          ],
          "variants": [
            {
              "when": {"machine": ["neighbor", "input"]},
              "lanes": []
            }
          ]
        }
      ],
      "setup": [
        ["machine", "mode", "loop_division", "trig_polyphony"]
