{
  "format": "elasticat-layout",
  "version": 1,
  "name": "elasticat-0.6.0",
  "note": "0.6.0 (docs/UX-V2.md): the categories are the modes; elasticat-0.5.0 (the owner's elasticat-02) rearranged into them: AMP gets an AMP page and MOD ENV, FX an FX MIX page (B11), SCENE moves to CROSSFADER",
  "categories": [
    {
      "cat": "TRIG",
      "mode": "TRIG",
      "tag": "TRIG",
      "button": "HOME",
      "order": 2,
      "pages": [
        {
          "title": "TRIG",
          "key": 1,
          "picture": "steps",
          "lanes": [
            [{"item": "pitch", "label": "NOTE"}, "default_length", "default_velocity", {"item": "micro_timing", "label": "MICRO"}],
            [null, {"item": "env_reset", "label": "ENV RESET"}, {"item": "lfo_reset", "label": "LFO RESET"}, {"item": "filter_reset", "label": "FILT RESET"}]
          ],
          "note": "FILT RESET: We should make this work, not a placeholder"
        },
        {
          "title": "COND",
          "key": 2,
          "picture": "steps",
          "lanes": [
            [{"item": "trig_chance", "label": "CHANCE"}, "trig_condition", {"item": "trig_ratchet", "label": "RATCHET"}]
          ]
        },
        {
          "title": "PLAYHEAD",
          "key": 3,
          "picture": "steps",
          "lanes": [
            [{"item": "trig_jump", "label": "SNAP START"}, {"item": "trig_release", "label": "RET MODE"}]
