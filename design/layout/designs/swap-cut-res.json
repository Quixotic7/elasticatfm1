{
  "format": "elasticat-layout",
  "version": 1,
  "name": "swap-cut-res",
  "note": "A test design: FILT / FILTER (classic) with RES on KNOB 1 and CUT on KNOB 2 (the layout tool's round-trip proof, results/layout/roundtrip)",
  "categories": [
    {
      "cat": "TRIG",
      "pages": [
        {
          "title": "TRIG",
          "picture": "steps",
          "lanes": [
            [{"item": "pitch", "label": "NOTE"}, "default_length", "default_velocity", null],
            ["env_reset", "lfo_reset", "filter_reset"]
          ]
        },
        {
          "title": "COND",
          "picture": "steps",
          "lanes": [
            ["trig_chance", "trig_condition", "trig_ratchet"]
          ]
        },
        {
          "title": "MTRIG",
          "picture": "steps",
          "lanes": [
            ["trig_jump", "trig_release"]
          ],
          "variants": [
            {
              "when": {"machine": ["slice", "razor"]},
              "title": "SLICE",
              "lanes": [
                ["slice_index", "slice_play_mode", "slice_ratchet", "slice_reverse"]
              ]
            }
          ]
        }
      ],
      "setup": [
        [{"item": "global.swing", "label": "SWING"}]
      ]
    },
    {
      "cat": "SRC",
      "pages": [
