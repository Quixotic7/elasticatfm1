            {
              "when": {"warp": ["GSTR2"]},
              "lanes": [
                [{"item": "grain_speed", "label": "STRCH"}, {"item": "grain_size", "label": "PWIN"}, {"item": "grain_density", "label": "SMTH"}, "warp_rate"]
