            [{"item": "pitch", "label": "PITCH"}, "sample_slot", {"item": "loop_start", "label": "START"}, "loop_end"],
            [{"item": "xfade", "label": "XFADE"}, {"item": "loop_reverse", "label": "REVERSE"}]
          ],
          "variants": [
            {
              "when": {"machine": ["neighbor", "input"]},
              "lanes": []
