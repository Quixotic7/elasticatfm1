            {
              "when": {"machine": ["slice", "razor"]},
              "lanes": [
                ["pitch", "slice_play_mode", "slice_index", "sample_slot"],
                ["slice_count", {"item": "e5.choke", "label": "CHOK"}, {"item": "e5.mute", "label": "SMUT"}, "slice_reverse"]
              ]
            }
          ]
        },
        {
          "title": "MACHINE",
          "picture": "wave-machine",
          "lanes": [
            [{"item": "loop_reverse", "label": "LREV"}, "xfade", "trig_release"]
          ],
          "variants": [
            {
              "when": {"machine": ["neighbor", "input"]},
              "lanes": []
            },
            {
              "when": {"machine": ["slice", "razor"]},
              "lanes": [
                [{"item": "slice_count", "label": "SLIC"}, "slice_play_mode", "slice_reverse", "slice_ratchet"],
                ["slice_sync", "slice_rate"]
              ]
            }
          ]
        },
        {
          "title": "WARP",
          "picture": "wave-warp",
          "lanes": [
            ["mode_macro", "warp_rate"]
          ],
          "variants": [
            {
              "when": {"machine": ["neighbor", "input"]},
              "lanes": []
            },
            {
              "when": {"warp": ["TAPE"]},
              "lanes": [
                ["warp_rate", "mode_switch_fade"]
              ]
            },
            {
              "when": {"warp": ["VARI"]},
              "lanes": [
                ["warp_rate", "mode_switch_fade"]
              ]
            },
            {
              "when": {"warp": ["DOMINO"]},
              "lanes": [
                [{"item": "chop_steps", "label": "SLCS"}, "chop_slice_len", "chop_loop_mode", "warp_rate"],
